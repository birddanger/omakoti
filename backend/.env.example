DATABASE_URL="file:./dev.db"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
NODE_ENV="development"
PORT=5000

# --- Reminder scheduler (optional) ---
# Cron expression for the daily reminder scan (server local time). Default: 07:00 daily.
REMINDER_CRON="0 7 * * *"
# Set to "true" to disable the background scheduler entirely.
DISABLE_SCHEDULER="false"

# --- Email reminders (optional) ---
# If these are unset, reminders are in-app only (email delivery is skipped).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="OmakotiApp <no-reply@omakotiapp.local>"
